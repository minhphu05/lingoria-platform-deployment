# ==============================================================================
# Platform Environment & Inter-Service Secrets (.env)
# ==============================================================================

COMPOSE_PROJECT_NAME=lingoria
COMPOSE_NETWORK=lingoria_network

# ------------------------------------------------------------------------------
# Inter-Service Communication Passwords
# Non-secret configurations (host, port, db name, user) are in configs/*.json.
# Admin/Superuser passwords are auto-generated directly inside container volumes.
# ------------------------------------------------------------------------------

# Password used by Airflow to connect to its PostgreSQL metadata database
AIRFLOW_DB_PASSWORD=airflow_service_change_me

# Secret key used by Airflow to communicate with MinIO (if required)
MINIO_SECRET_KEY=minioadmin_change_me
